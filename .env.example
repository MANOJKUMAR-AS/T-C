# ============================================================
# T&C Analyzer Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Gemini / Agent 2
# ------------------------------------------------------------

GEMINI_API_KEY=

# Primary Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback Gemini model
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Agent 2 chunking
LLM_CHUNK_CHARS=9000
LLM_CHUNK_OVERLAP_CHARS=300

# Maximum output tokens per Gemini request
LLM_MAX_OUTPUT_TOKENS=2500

# Maximum Gemini requests allowed per analysis run
LLM_MAX_REQUESTS_PER_RUN=12

# Delay between Gemini requests
LLM_REQUEST_DELAY_SECONDS=12.5


# ------------------------------------------------------------
# Firecrawl / Agent 1 fallback
# ------------------------------------------------------------

# Get this from Firecrawl.
# Example:
# FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx
FIRECRAWL_API_KEY=


# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001